{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6b22\u8fce\u4f7f\u7528 AI Studio","text":""},{"location":"#ai-studio_1","title":"AI Studio \u4f7f\u7528\u8bf4\u660e","text":""},{"location":"%E5%85%B3%E4%BA%8EAI%20Studio/%E8%83%8C%E6%99%AF%E4%BB%8B%E7%BB%8D/","title":"\u80cc\u666f\u4ecb\u7ecd","text":""},{"location":"%E5%85%B3%E4%BA%8EAI%20Studio/%E8%83%8C%E6%99%AF%E4%BB%8B%E7%BB%8D/#_1","title":"\u5e73\u53f0\u7b80\u4ecb","text":"<p>AI Studio \u662f\u9762\u5411\u89c6\u9891\u5206\u6790\u4e0e\u4e8b\u4ef6\u5904\u7406\u7684\u7edf\u4e00\u5e73\u53f0\uff0c\u63d0\u4f9b\u8bbe\u5907\u63a5\u5165\u3001\u8bc6\u522b\u5206\u6790\u3001\u4e8b\u4ef6\u95ed\u73af\u3001\u6a21\u578b\u8bad\u7ec3\u3001\u6570\u636e\u77e5\u8bc6\u7ba1\u7406\u3001AI \u52a9\u624b\u548c API \u96c6\u6210\u80fd\u529b\u3002</p> <p>\u5e73\u53f0\u4e2d\u7684\u8bc6\u522b\u7ed3\u679c\u7528\u4e8e\u8f85\u52a9\u53d1\u73b0\u95ee\u9898\uff0c\u6700\u7ec8\u5904\u7f6e\u5e94\u7ed3\u5408\u73b0\u573a\u60c5\u51b5\u548c\u539f\u59cb\u8bc1\u636e\u5b8c\u6210\u3002</p>"},{"location":"%E5%85%B3%E4%BA%8EAI%20Studio/%E9%80%82%E7%94%A8%E8%8C%83%E5%9B%B4/","title":"\u9002\u7528\u8303\u56f4","text":""},{"location":"%E5%85%B3%E4%BA%8EAI%20Studio/%E9%80%82%E7%94%A8%E8%8C%83%E5%9B%B4/#_1","title":"\u9002\u7528\u4eba\u5458","text":"<ul> <li>\u5e73\u53f0\u7ba1\u7406\u5458\uff1a\u8d1f\u8d23\u8d26\u53f7\u3001\u89d2\u8272\u3001\u7cfb\u7edf\u72b6\u6001\u3001\u5b58\u50a8\u548c\u7248\u672c\u7ef4\u62a4\u3002</li> <li>\u4e1a\u52a1\u4eba\u5458\uff1a\u8d1f\u8d23\u8bbe\u5907\u67e5\u770b\u3001\u8bc6\u522b\u4efb\u52a1\u548c\u4e8b\u4ef6\u5904\u7406\u3002</li> <li>\u7b97\u6cd5\u4eba\u5458\uff1a\u8d1f\u8d23\u6570\u636e\u96c6\u3001\u6a21\u578b\u8bad\u7ec3\u3001\u8bc4\u4f30\u548c\u53d1\u5e03\u3002</li> <li>\u96c6\u6210\u4eba\u5458\uff1a\u8d1f\u8d23 API \u51ed\u8bc1\u548c\u5916\u90e8\u7cfb\u7edf\u8c03\u7528\u3002</li> </ul> <p>\u4e0d\u540c\u89d2\u8272\u770b\u5230\u7684\u83dc\u5355\u548c\u64cd\u4f5c\u6309\u94ae\u53ef\u80fd\u4e0d\u540c\u3002\u672c\u6587\u6863\u4e2d\u7684\u7ba1\u7406\u64cd\u4f5c\u4ec5\u9650\u5177\u5907\u5bf9\u5e94\u6743\u9650\u7684\u8d26\u53f7\u6267\u884c\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/AI%E5%8A%A9%E6%89%8B/","title":"AI \u52a9\u624b","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/AI%E5%8A%A9%E6%89%8B/#_1","title":"\u529f\u80fd\u8bf4\u660e","text":"<p>AI \u52a9\u624b\u7528\u4e8e\u57fa\u4e8e\u5e73\u53f0\u6570\u636e\u8fdb\u884c\u95ee\u7b54\u548c\u8f85\u52a9\u5206\u6790\u3002\u53ef\u7528\u80fd\u529b\u7531\u8d26\u53f7\u6743\u9650\u3001\u5df2\u914d\u7f6e\u7684\u6a21\u578b\u548c\u77e5\u8bc6\u5e93\u51b3\u5b9a\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/AI%E5%8A%A9%E6%89%8B/#_2","title":"\u4f7f\u7528\u6b65\u9aa4","text":"<ol> <li>\u8fdb\u5165 AI \u52a9\u624b\uff0c\u9009\u62e9\u5bf9\u8bdd\u6216\u5df2\u914d\u7f6e\u7684\u52a9\u624b\u3002</li> <li>\u8f93\u5165\u95ee\u9898\u65f6\u8bf4\u660e\u5bf9\u8c61\u3001\u65f6\u95f4\u8303\u56f4\u548c\u671f\u671b\u8f93\u51fa\uff0c\u907f\u514d\u63d0\u4ea4\u65e0\u5173\u7684\u654f\u611f\u4fe1\u606f\u3002</li> <li>\u6838\u5bf9\u56de\u7b54\u5f15\u7528\u7684\u6570\u636e\u548c\u65f6\u95f4\uff0c\u4e0d\u8981\u5c06\u6a21\u578b\u56de\u7b54\u76f4\u63a5\u4f5c\u4e3a\u6700\u7ec8\u4e1a\u52a1\u7ed3\u8bba\u3002</li> <li>\u9700\u8981\u590d\u7528\u65f6\u4fdd\u5b58\u5bf9\u8bdd\u6458\u8981\uff0c\u5e76\u6309\u6743\u9650\u5171\u4eab\u7ed9\u76f8\u5173\u4eba\u5458\u3002</li> </ol> <p>\u82e5\u52a9\u624b\u65e0\u6cd5\u56de\u7b54\uff0c\u68c0\u67e5\u6a21\u578b\u3001\u77e5\u8bc6\u5e93\u548c\u6743\u9650\u662f\u5426\u53ef\u7528\uff1b\u6d89\u53ca\u8bc6\u522b\u7ed3\u679c\u65f6\u56de\u5230\u4e8b\u4ef6\u6216\u8bc6\u522b\u9875\u9762\u6838\u5bf9\u539f\u59cb\u8bc1\u636e\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/API%E7%AE%A1%E7%90%86/","title":"API \u7ba1\u7406","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/API%E7%AE%A1%E7%90%86/#_1","title":"\u529f\u80fd\u8bf4\u660e","text":"<p>API \u7ba1\u7406\u7528\u4e8e\u67e5\u770b\u5df2\u53d1\u5e03\u63a5\u53e3\u3001\u914d\u7f6e\u8c03\u7528\u51ed\u8bc1\u548c\u67e5\u8be2\u8c03\u7528\u8bb0\u5f55\u3002\u53ea\u6709\u660e\u786e\u7684\u7cfb\u7edf\u96c6\u6210\u9700\u6c42\u624d\u5e94\u521b\u5efa API \u51ed\u8bc1\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/API%E7%AE%A1%E7%90%86/#api","title":"\u4f7f\u7528 API","text":"<ol> <li>\u6253\u5f00 API \u7ba1\u7406\uff0c\u67e5\u770b\u63a5\u53e3\u540d\u79f0\u3001\u7248\u672c\u3001\u72b6\u6001\u548c\u6743\u9650\u8303\u56f4\u3002</li> <li>\u521b\u5efa\u51ed\u8bc1\u65f6\u586b\u5199\u7528\u9014\u548c\u6709\u6548\u671f\uff0c\u5e76\u4ec5\u6388\u4e88\u6240\u9700\u63a5\u53e3\u6743\u9650\u3002</li> <li>\u51ed\u8bc1\u53ea\u5728\u521b\u5efa\u65f6\u5b8c\u6574\u663e\u793a\u4e00\u6b21\uff0c\u5e94\u4fdd\u5b58\u5230\u53d7\u63a7\u7684\u5bc6\u94a5\u7ba1\u7406\u4f4d\u7f6e\u3002</li> <li>\u8c03\u7528\u5931\u8d25\u65f6\u67e5\u770b\u54cd\u5e94\u72b6\u6001\u3001\u63a5\u53e3\u7248\u672c\u3001\u6743\u9650\u8303\u56f4\u548c API \u65e5\u5fd7\u3002</li> </ol> <p>\u51ed\u8bc1\u6cc4\u9732\u6216\u4e0d\u518d\u4f7f\u7528\u65f6\u5e94\u7acb\u5373\u64a4\u9500\u5e76\u91cd\u65b0\u751f\u6210\u3002\u4e0d\u8981\u628a\u4ee4\u724c\u5199\u5165\u524d\u7aef\u4ee3\u7801\u3001\u622a\u56fe\u3001\u5de5\u5355\u6216\u516c\u5f00\u4ed3\u5e93\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E4%BA%8B%E4%BB%B6/","title":"\u4e8b\u4ef6","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E4%BA%8B%E4%BB%B6/#_1","title":"\u4e8b\u4ef6\u5217\u8868","text":"<p>\u4e8b\u4ef6\u7531\u8bc6\u522b\u89c4\u5219\u89e6\u53d1\uff0c\u5305\u542b\u53d1\u751f\u65f6\u95f4\u3001\u6765\u6e90\u8bbe\u5907\u3001\u4e8b\u4ef6\u7c7b\u578b\u3001\u5904\u7406\u72b6\u6001\u548c\u8bc1\u636e\u3002\u8fdb\u5165 \u4e8b\u4ef6 \u540e\uff0c\u53ef\u6309\u65f6\u95f4\u3001\u72b6\u6001\u3001\u8bbe\u5907\u548c\u4e8b\u4ef6\u7c7b\u578b\u7b5b\u9009\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E4%BA%8B%E4%BB%B6/#_2","title":"\u5904\u7406\u4e8b\u4ef6","text":"<ol> <li>\u6253\u5f00\u4e8b\u4ef6\u8be6\u60c5\uff0c\u6838\u5bf9\u53d1\u751f\u65f6\u95f4\u3001\u8bbe\u5907\u548c\u56fe\u7247\u6216\u89c6\u9891\u8bc1\u636e\u3002</li> <li>\u6839\u636e\u73b0\u573a\u60c5\u51b5\u9009\u62e9\u786e\u8ba4\u95ee\u9898\u3001\u6807\u8bb0\u8bef\u62a5\u6216\u8f6c\u5165\u6574\u6539\u6d41\u7a0b\u3002</li> <li>\u586b\u5199\u5904\u7406\u8bf4\u660e\u548c\u8d23\u4efb\u4eba\uff0c\u63d0\u4ea4\u540e\u786e\u8ba4\u72b6\u6001\u5df2\u66f4\u65b0\u3002</li> </ol> <p>\u4e8b\u4ef6\u8bc1\u636e\u53ef\u80fd\u5305\u542b\u4eba\u5458\u548c\u73b0\u573a\u4fe1\u606f\uff0c\u4ec5\u5411\u6388\u6743\u4eba\u5458\u5171\u4eab\u3002\u5904\u7406\u524d\u4e0d\u8981\u4fee\u6539\u539f\u59cb\u8bc1\u636e\u6587\u4ef6\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%95%B0%E6%8D%AE%E4%B8%8E%E7%9F%A5%E8%AF%86/","title":"\u6570\u636e\u4e0e\u77e5\u8bc6","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%95%B0%E6%8D%AE%E4%B8%8E%E7%9F%A5%E8%AF%86/#_1","title":"\u6570\u636e\u4e2d\u5fc3","text":"<p>\u6570\u636e\u4e2d\u5fc3\u7528\u4e8e\u7ba1\u7406\u6570\u636e\u6e90\u3001\u5a92\u4f53\u6587\u4ef6\u3001\u6807\u7b7e\u548c\u77e5\u8bc6\u5e93\u3002\u4e0a\u4f20\u6570\u636e\u524d\u786e\u8ba4\u6587\u4ef6\u683c\u5f0f\u3001\u5927\u5c0f\u548c\u6765\u6e90\u7b26\u5408\u5e73\u53f0\u8981\u6c42\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%95%B0%E6%8D%AE%E4%B8%8E%E7%9F%A5%E8%AF%86/#_2","title":"\u6570\u636e\u4e0e\u77e5\u8bc6\u5e93\u64cd\u4f5c","text":"<ol> <li>\u521b\u5efa\u6570\u636e\u96c6\u6216\u77e5\u8bc6\u5e93\u5e76\u586b\u5199\u7528\u9014\u8bf4\u660e\u3002</li> <li>\u4e0a\u4f20\u6587\u4ef6\u540e\u7b49\u5f85\u5e73\u53f0\u5b8c\u6210\u89e3\u6790\uff0c\u68c0\u67e5\u6587\u4ef6\u6570\u91cf\u548c\u5904\u7406\u72b6\u6001\u3002</li> <li>\u5bf9\u6570\u636e\u8fdb\u884c\u5206\u7c7b\u3001\u6253\u6807\u7b7e\u6216\u8865\u5145\u5143\u6570\u636e\uff0c\u4fbf\u4e8e\u68c0\u7d22\u548c\u8bad\u7ec3\u3002</li> <li>\u5220\u9664\u524d\u786e\u8ba4\u6ca1\u6709\u8bad\u7ec3\u4efb\u52a1\u3001\u8bc6\u522b\u5de5\u4f5c\u6d41\u6216 AI \u52a9\u624b\u5f15\u7528\u8be5\u6570\u636e\u3002</li> </ol> <p>\u89e3\u6790\u5931\u8d25\u65f6\u68c0\u67e5\u6587\u4ef6\u7f16\u7801\u3001\u683c\u5f0f\u3001\u5927\u5c0f\u548c\u5b58\u50a8\u7a7a\u95f4\uff1b\u4fee\u6b63\u540e\u91cd\u65b0\u4e0a\u4f20\uff0c\u4e0d\u8981\u76f4\u63a5\u91cd\u590d\u63d0\u4ea4\u540c\u4e00\u5931\u8d25\u6587\u4ef6\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%A8%A1%E5%9E%8B%E4%B8%8E%E8%AE%AD%E7%BB%83/","title":"\u6a21\u578b\u4e0e\u8bad\u7ec3","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%A8%A1%E5%9E%8B%E4%B8%8E%E8%AE%AD%E7%BB%83/#_1","title":"\u6a21\u578b\u4e2d\u5fc3","text":"<p>\u6a21\u578b\u4e2d\u5fc3\u7528\u4e8e\u7ba1\u7406\u6a21\u578b\u3001\u6570\u636e\u96c6\u3001\u8bad\u7ec3\u4efb\u52a1\u548c\u8bc4\u4f30\u7ed3\u679c\u3002\u8bad\u7ec3\u524d\u5e94\u786e\u8ba4\u6570\u636e\u96c6\u5df2\u5b8c\u6210\u68c0\u67e5\uff0c\u4e14\u8d26\u53f7\u5177\u6709\u6a21\u578b\u6216\u8bad\u7ec3\u6743\u9650\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%A8%A1%E5%9E%8B%E4%B8%8E%E8%AE%AD%E7%BB%83/#_2","title":"\u8bad\u7ec3\u6d41\u7a0b","text":"<ol> <li>\u5728 \u6a21\u578b\u4e2d\u5fc3 \u521b\u5efa\u6216\u9009\u62e9\u6570\u636e\u96c6\uff0c\u68c0\u67e5\u7c7b\u522b\u3001\u6807\u6ce8\u548c\u8bad\u7ec3/\u9a8c\u8bc1\u5212\u5206\u3002</li> <li>\u9009\u62e9\u57fa\u7840\u6a21\u578b\uff0c\u586b\u5199\u8bad\u7ec3\u540d\u79f0\u3001\u56fe\u50cf\u5c3a\u5bf8\u3001\u6279\u6b21\u548c\u8bad\u7ec3\u8f6e\u6570\u7b49\u53c2\u6570\u3002</li> <li>\u63d0\u4ea4\u8bad\u7ec3\u4efb\u52a1\u540e\uff0c\u5728\u8bad\u7ec3\u5217\u8868\u67e5\u770b\u6392\u961f\u3001\u8fd0\u884c\u3001\u5b8c\u6210\u6216\u5931\u8d25\u72b6\u6001\u3002</li> <li>\u8bad\u7ec3\u5b8c\u6210\u540e\u67e5\u770b\u6307\u6807\u548c\u6837\u4f8b\u9884\u6d4b\uff0c\u786e\u8ba4\u7ed3\u679c\u540e\u518d\u53d1\u5e03\u6a21\u578b\u3002</li> </ol> <p>\u8bad\u7ec3\u5931\u8d25\u65f6\u5148\u67e5\u770b\u4efb\u52a1\u65e5\u5fd7\u548c\u8d44\u6e90\u4f7f\u7528\u60c5\u51b5\u3002\u4e0d\u8981\u5728\u540c\u4e00\u6570\u636e\u548c\u53c2\u6570\u4e0b\u53cd\u590d\u63d0\u4ea4\u4efb\u52a1\uff0c\u5e94\u5148\u4fee\u6b63\u6570\u636e\u3001\u663e\u5b58\u6216\u53c2\u6570\u95ee\u9898\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E6%A8%A1%E5%9E%8B%E4%B8%8E%E8%AE%AD%E7%BB%83/#_3","title":"\u6a21\u578b\u53d1\u5e03\u4e0e\u4f7f\u7528","text":"<p>\u53ea\u6709\u7ecf\u8fc7\u8bc4\u4f30\u7684\u6a21\u578b\u624d\u5e94\u53d1\u5e03\u5230\u8bc6\u522b\u6d41\u7a0b\u3002\u53d1\u5e03\u524d\u8bb0\u5f55\u7248\u672c\u3001\u9002\u7528\u573a\u666f\u548c\u5df2\u77e5\u9650\u5236\uff1b\u66ff\u6362\u7ebf\u4e0a\u6a21\u578b\u524d\u4fdd\u7559\u539f\u7248\u672c\uff0c\u4ee5\u4fbf\u56de\u9000\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/","title":"\u7cfb\u7edf\u7ba1\u7406","text":"<p>\u7cfb\u7edf\u7ba1\u7406\u7528\u4e8e\u7ef4\u62a4\u5e73\u53f0\u8d26\u53f7\u3001\u6743\u9650\u3001\u8fd0\u884c\u65e5\u5fd7\u3001\u5b58\u50a8\u7a7a\u95f4\u548c\u5e73\u53f0\u7248\u672c\u3002\u8be5\u6a21\u5757\u5305\u542b\u7ba1\u7406\u7ea7\u64cd\u4f5c\uff0c\u5efa\u8bae\u7531\u5e73\u53f0\u7ba1\u7406\u5458\u4f7f\u7528\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_1","title":"\u8fdb\u5165\u7cfb\u7edf\u7ba1\u7406","text":"<ol> <li>\u767b\u5f55 AI Studio\u3002</li> <li>\u5728\u5de6\u4fa7\u5bfc\u822a\u680f\u9009\u62e9 \u7cfb\u7edf\u7ba1\u7406\u3002</li> <li>\u9ed8\u8ba4\u6253\u5f00\u7cfb\u7edf\u603b\u89c8\uff0c\u4e5f\u53ef\u4ee5\u901a\u8fc7\u9875\u9762\u89c6\u56fe\u5207\u6362\u5230\u7528\u6237\u3001\u89d2\u8272\u3001\u65e5\u5fd7\u3001\u5b58\u50a8\u6216\u66f4\u65b0\u9875\u9762\u3002</li> </ol> <p>\u7cfb\u7edf\u7ba1\u7406\u76f8\u5173\u5730\u5740\u5982\u4e0b\uff1a</p> \u529f\u80fd \u5730\u5740 \u9002\u7528\u89d2\u8272 \u7cfb\u7edf\u603b\u89c8 <code>/system?view=overview</code> \u7ba1\u7406\u5458 \u7528\u6237\u7ba1\u7406 <code>/system?view=users</code> \u7ba1\u7406\u5458\uff0c\u9700\u5177\u5907\u7528\u6237\u67e5\u770b\u6743\u9650 \u89d2\u8272\u4e0e\u6743\u9650 <code>/system?view=roles</code> \u7ba1\u7406\u5458\uff0c\u9700\u5177\u5907\u6743\u9650\u7ba1\u7406\u6743\u9650 \u65e5\u5fd7\u7ba1\u7406 <code>/system?view=logs</code> \u7ba1\u7406\u5458 \u5b58\u50a8\u7ba1\u7406 <code>/system?view=storage</code> \u7ba1\u7406\u5458\uff0c\u9700\u5177\u5907\u5b58\u50a8\u67e5\u770b\u6743\u9650 \u5e73\u53f0\u66f4\u65b0 <code>/system?view=updates</code> \u7528\u6237\u548c\u7ba1\u7406\u5458"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_2","title":"\u7cfb\u7edf\u603b\u89c8","text":"<p>\u7cfb\u7edf\u603b\u89c8\u7528\u4e8e\u5feb\u901f\u67e5\u770b\u5e73\u53f0\u5f53\u524d\u8fd0\u884c\u72b6\u6001\u3002\u8fdb\u5165\u9875\u9762\u540e\uff0c\u5148\u786e\u8ba4\u9875\u9762\u6ca1\u6709\u9519\u8bef\u63d0\u793a\uff0c\u518d\u6839\u636e\u72b6\u6001\u4fe1\u606f\u5224\u65ad\u662f\u5426\u9700\u8981\u8fdb\u4e00\u6b65\u68c0\u67e5\u7528\u6237\u3001\u65e5\u5fd7\u6216\u5b58\u50a8\u3002</p> <p>\u5efa\u8bae\u6309\u7167\u4ee5\u4e0b\u987a\u5e8f\u68c0\u67e5\uff1a</p> <ol> <li>\u67e5\u770b\u5e73\u53f0\u6574\u4f53\u72b6\u6001\u548c\u7248\u672c\u4fe1\u606f\u3002</li> <li>\u68c0\u67e5\u6700\u8fd1\u7684\u5f02\u5e38\u6216\u544a\u8b66\u3002</li> <li>\u5982\u679c\u9875\u9762\u63d0\u793a\u8d44\u6e90\u4e0d\u8db3\uff0c\u8f6c\u5230 \u5b58\u50a8\u7ba1\u7406 \u67e5\u770b\u7a7a\u95f4\u4f7f\u7528\u60c5\u51b5\u3002</li> <li>\u5982\u679c\u51fa\u73b0\u8bbf\u95ee\u6216\u64cd\u4f5c\u5f02\u5e38\uff0c\u8f6c\u5230 \u65e5\u5fd7\u7ba1\u7406 \u67e5\u8be2\u5bf9\u5e94\u65f6\u95f4\u6bb5\u7684\u8bb0\u5f55\u3002</li> </ol>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_3","title":"\u603b\u89c8\u9875\u7684\u65e5\u5e38\u68c0\u67e5","text":"<p>\u5efa\u8bae\u7ba1\u7406\u5458\u6bcf\u5929\u9996\u6b21\u767b\u5f55\u540e\u5b8c\u6210\u4e00\u6b21\u5feb\u901f\u68c0\u67e5\uff1a</p> <ol> <li>\u786e\u8ba4\u9875\u9762\u9876\u90e8\u6ca1\u6709\u7f51\u7edc\u3001\u670d\u52a1\u4e0d\u53ef\u7528\u6216\u6743\u9650\u4e0d\u8db3\u63d0\u793a\u3002</li> <li>\u8bb0\u5f55\u5f53\u524d\u5e73\u53f0\u7248\u672c\uff1b\u5347\u7ea7\u6216\u6545\u969c\u62a5\u4fee\u65f6\u9700\u8981\u63d0\u4f9b\u8be5\u7248\u672c\u53f7\u3002</li> <li>\u67e5\u770b\u8fd0\u884c\u72b6\u6001\u3001\u4efb\u52a1\u72b6\u6001\u548c\u8d44\u6e90\u4f7f\u7528\u7387\u3002\u51fa\u73b0\u5f02\u5e38\u65f6\uff0c\u5148\u8bb0\u5f55\u65f6\u95f4\u548c\u9875\u9762\u63d0\u793a\uff0c\u518d\u8fdb\u5165\u65e5\u5fd7\u7ba1\u7406\u3002</li> <li>\u70b9\u51fb\u5237\u65b0\u6309\u94ae\u91cd\u65b0\u83b7\u53d6\u72b6\u6001\u3002\u5237\u65b0\u540e\u4ecd\u5f02\u5e38\uff0c\u624d\u6309\u6545\u969c\u6d41\u7a0b\u7ee7\u7eed\u6392\u67e5\u3002</li> </ol> <p>\u603b\u89c8\u9875\u663e\u793a\u7684\u662f\u5f53\u524d\u65f6\u523b\u7684\u72b6\u6001\uff0c\u6d89\u53ca\u4efb\u52a1\u6570\u91cf\u3001\u5b58\u50a8\u7a7a\u95f4\u6216\u670d\u52a1\u72b6\u6001\u7684\u5224\u65ad\uff0c\u5e94\u4ee5\u5237\u65b0\u540e\u7684\u6570\u636e\u4e3a\u51c6\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_4","title":"\u7528\u6237\u7ba1\u7406","text":"<p>\u7528\u6237\u7ba1\u7406\u7528\u4e8e\u67e5\u770b\u548c\u7ef4\u62a4\u5e73\u53f0\u8d26\u53f7\u3002\u5904\u7406\u8d26\u53f7\u95ee\u9898\u65f6\uff0c\u5e94\u5148\u786e\u8ba4\u7528\u6237\u540d\u3001\u6240\u5c5e\u89d2\u8272\u548c\u8d26\u53f7\u72b6\u6001\uff0c\u518d\u6267\u884c\u4fee\u6539\u6216\u505c\u7528\u64cd\u4f5c\u3002</p> <p>\u5efa\u8bae\uff1a</p> <ul> <li>\u6bcf\u4e2a\u8d26\u53f7\u53ea\u6388\u4e88\u5b8c\u6210\u5de5\u4f5c\u6240\u9700\u7684\u6700\u5c0f\u6743\u9650\u3002</li> <li>\u79bb\u804c\u3001\u8f6c\u5c97\u6216\u957f\u671f\u4e0d\u4f7f\u7528\u7684\u8d26\u53f7\u5e94\u53ca\u65f6\u505c\u7528\u3002</li> <li>\u4e0d\u8981\u591a\u4eba\u5171\u7528\u7ba1\u7406\u5458\u8d26\u53f7\uff0c\u907f\u514d\u65e5\u5fd7\u65e0\u6cd5\u8ffd\u6eaf\u5230\u5177\u4f53\u64cd\u4f5c\u8005\u3002</li> <li>\u4fee\u6539\u6743\u9650\u540e\uff0c\u8ba9\u7528\u6237\u91cd\u65b0\u767b\u5f55\u4ee5\u786e\u8ba4\u6743\u9650\u5df2\u751f\u6548\u3002</li> </ul>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_5","title":"\u65b0\u589e\u6216\u7ef4\u62a4\u8d26\u53f7","text":"<ol> <li>\u6253\u5f00 \u7528\u6237\u7ba1\u7406\uff0c\u6309\u7528\u6237\u540d\u6216\u8d26\u53f7\u6807\u8bc6\u67e5\u627e\u7528\u6237\u3002</li> <li>\u65b0\u589e\u8d26\u53f7\u65f6\u586b\u5199\u53ef\u8bc6\u522b\u7684\u7528\u6237\u540d\uff0c\u5e76\u5206\u914d\u4e1a\u52a1\u6240\u9700\u7684\u89d2\u8272\uff1b\u4e0d\u8981\u4f7f\u7528\u591a\u4eba\u5171\u7528\u8d26\u53f7\u3002</li> <li>\u4fee\u6539\u8d26\u53f7\u524d\u6838\u5bf9\u8d26\u53f7\u72b6\u6001\u548c\u5f53\u524d\u89d2\u8272\u3002\u505c\u7528\u8d26\u53f7\u524d\u786e\u8ba4\u6ca1\u6709\u6b63\u5728\u8fd0\u884c\u7684\u4efb\u52a1\u5f52\u5c5e\u8be5\u8d26\u53f7\u3002</li> <li>\u4fdd\u5b58\u540e\u91cd\u65b0\u6253\u5f00\u8d26\u53f7\u8be6\u60c5\uff0c\u786e\u8ba4\u72b6\u6001\u3001\u89d2\u8272\u548c\u66f4\u65b0\u65f6\u95f4\u5df2\u751f\u6548\u3002</li> </ol>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_6","title":"\u89d2\u8272\u4e0e\u6743\u9650","text":"<p>\u89d2\u8272\u7528\u4e8e\u96c6\u4e2d\u5206\u914d\u529f\u80fd\u6743\u9650\u3002\u65b0\u589e\u6216\u8c03\u6574\u89d2\u8272\u65f6\uff0c\u5148\u660e\u786e\u4e1a\u52a1\u8303\u56f4\uff0c\u518d\u9010\u9879\u52fe\u9009\u6743\u9650\uff1b\u4e0d\u8981\u76f4\u63a5\u590d\u5236\u7ba1\u7406\u5458\u89d2\u8272\u7ed9\u666e\u901a\u7528\u6237\u3002</p> <p>\u6743\u9650\u8c03\u6574\u5b8c\u6210\u540e\uff0c\u5efa\u8bae\u7528\u76ee\u6807\u8d26\u53f7\u9a8c\u8bc1\u4ee5\u4e0b\u5185\u5bb9\uff1a</p> <ol> <li>\u53ef\u4ee5\u770b\u5230\u7684\u83dc\u5355\u662f\u5426\u7b26\u5408\u9884\u671f\u3002</li> <li>\u53ea\u8bfb\u7528\u6237\u662f\u5426\u65e0\u6cd5\u6267\u884c\u65b0\u589e\u3001\u4fee\u6539\u6216\u5220\u9664\u64cd\u4f5c\u3002</li> <li>\u65e0\u6743\u9650\u8bbf\u95ee\u9875\u9762\u65f6\uff0c\u5e73\u53f0\u662f\u5426\u6b63\u786e\u63d0\u793a\u6743\u9650\u4e0d\u8db3\u3002</li> </ol> <p>\u6743\u9650\u9075\u5faa\u201c\u6309\u9700\u6388\u6743\u201d\u539f\u5219\u3002\u67e5\u770b\u6743\u9650\u53ea\u5141\u8bb8\u8bfb\u53d6\u6570\u636e\uff0c\u7f16\u8f91\u6743\u9650\u5141\u8bb8\u65b0\u589e\u6216\u4fee\u6539\uff0c\u5220\u9664\u548c\u7cfb\u7edf\u914d\u7f6e\u6743\u9650\u5e94\u4ec5\u6388\u4e88\u660e\u786e\u8d1f\u8d23\u8be5\u4e1a\u52a1\u7684\u7ba1\u7406\u5458\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_7","title":"\u65e5\u5fd7\u7ba1\u7406","text":"<p>\u65e5\u5fd7\u7ba1\u7406\u7528\u4e8e\u5b9a\u4f4d\u767b\u5f55\u5931\u8d25\u3001\u6743\u9650\u53d8\u66f4\u3001\u914d\u7f6e\u4fee\u6539\u548c\u5e73\u53f0\u5f02\u5e38\u3002\u6392\u67e5\u95ee\u9898\u65f6\u5efa\u8bae\u8bb0\u5f55\uff1a\u53d1\u751f\u65f6\u95f4\u3001\u64cd\u4f5c\u8005\u3001\u529f\u80fd\u9875\u9762\u3001\u64cd\u4f5c\u7c7b\u578b\u548c\u9519\u8bef\u4fe1\u606f\u3002</p> <p>\u67e5\u8be2\u65e5\u5fd7\u7684\u5efa\u8bae\u6d41\u7a0b\uff1a</p> <ol> <li>\u5148\u6309\u95ee\u9898\u53d1\u751f\u65f6\u95f4\u7f29\u5c0f\u8303\u56f4\u3002</li> <li>\u518d\u6309\u7528\u6237\u6216\u64cd\u4f5c\u7c7b\u578b\u7b5b\u9009\u3002</li> <li>\u6253\u5f00\u5177\u4f53\u8bb0\u5f55\uff0c\u6838\u5bf9\u8bf7\u6c42\u7ed3\u679c\u548c\u5931\u8d25\u539f\u56e0\u3002</li> <li>\u5c06\u5173\u952e\u65e5\u5fd7\u7f16\u53f7\u6216\u622a\u56fe\u9644\u5230\u6545\u969c\u8bb0\u5f55\u4e2d\u3002</li> </ol> <p>\u65e5\u5fd7\u53ef\u80fd\u5305\u542b\u7528\u6237\u540d\u3001IP \u5730\u5740\u6216\u4e1a\u52a1\u6570\u636e\uff0c\u4e0d\u5e94\u76f4\u63a5\u516c\u5f00\u6216\u53d1\u9001\u5230\u975e\u6388\u6743\u6e20\u9053\u3002</p> <p>\u6392\u67e5\u5b8c\u6210\u540e\u5e94\u4fdd\u7559\u53d1\u751f\u65f6\u95f4\uff08\u542b\u65f6\u533a\uff09\u3001\u8d26\u53f7\u3001\u9875\u9762\u5730\u5740\u3001\u64cd\u4f5c\u6b65\u9aa4\u3001\u9519\u8bef\u63d0\u793a\u548c\u65e5\u5fd7\u7f16\u53f7\u3002\u6d89\u53ca\u9690\u79c1\u7684\u6570\u636e\u5728\u5bf9\u5916\u63d0\u4ea4\u524d\u5e94\u8131\u654f\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_8","title":"\u5b58\u50a8\u7ba1\u7406","text":"<p>\u5b58\u50a8\u7ba1\u7406\u7528\u4e8e\u67e5\u770b\u5e73\u53f0\u6587\u4ef6\u3001\u56fe\u7247\u3001\u6a21\u578b\u6216\u6570\u636e\u96c6\u5360\u7528\u60c5\u51b5\u3002\u7a7a\u95f4\u63a5\u8fd1\u4e0a\u9650\u65f6\uff0c\u4f18\u5148\u6e05\u7406\u786e\u8ba4\u4e0d\u518d\u4f7f\u7528\u7684\u4e34\u65f6\u6587\u4ef6\u548c\u5386\u53f2\u4ea7\u7269\uff1b\u5220\u9664\u524d\u5e94\u786e\u8ba4\u6ca1\u6709\u4efb\u52a1\u3001\u6a21\u578b\u6216\u77e5\u8bc6\u5e93\u5f15\u7528\u8fd9\u4e9b\u6587\u4ef6\u3002</p> <p>\u6e05\u7406\u5b8c\u6210\u540e\u91cd\u65b0\u5237\u65b0\u9875\u9762\uff0c\u786e\u8ba4\u5df2\u7528\u7a7a\u95f4\u548c\u53ef\u7528\u7a7a\u95f4\u5747\u5df2\u66f4\u65b0\u3002\u4e0d\u8981\u76f4\u63a5\u5728\u670d\u52a1\u5668\u6587\u4ef6\u7cfb\u7edf\u4e2d\u5220\u9664\u5e73\u53f0\u76ee\u5f55\uff0c\u4ee5\u514d\u4ea7\u751f\u6570\u636e\u5e93\u8bb0\u5f55\u4e0e\u5b9e\u9645\u6587\u4ef6\u4e0d\u4e00\u81f4\u3002</p> <p>\u5f53\u53ef\u7528\u7a7a\u95f4\u63a5\u8fd1\u4e0a\u9650\u65f6\uff0c\u5148\u6682\u505c\u5927\u6587\u4ef6\u4e0a\u4f20\u3001\u6a21\u578b\u8bad\u7ec3\u6216\u6279\u91cf\u5bfc\u5165\uff0c\u518d\u6309\u201c\u4e34\u65f6\u6587\u4ef6\u2014\u5931\u8d25\u4efb\u52a1\u4ea7\u7269\u2014\u786e\u8ba4\u65e0\u5f15\u7528\u7684\u5386\u53f2\u7248\u672c\u201d\u7684\u987a\u5e8f\u6e05\u7406\u3002\u6b63\u5728\u4f7f\u7528\u7684\u6a21\u578b\u3001\u6570\u636e\u96c6\u548c\u77e5\u8bc6\u5e93\u6587\u4ef6\u4e0d\u53ef\u5220\u9664\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_9","title":"\u5e73\u53f0\u66f4\u65b0","text":"<p>\u5e73\u53f0\u66f4\u65b0\u7528\u4e8e\u67e5\u770b\u5f53\u524d\u7248\u672c\u53ca\u53ef\u7528\u66f4\u65b0\u3002\u6267\u884c\u66f4\u65b0\u524d\u5e94\u5b8c\u6210\u4ee5\u4e0b\u51c6\u5907\uff1a</p> <ul> <li>\u786e\u8ba4\u5f53\u524d\u6ca1\u6709\u6b63\u5728\u8fd0\u884c\u7684\u8bc6\u522b\u3001\u8bad\u7ec3\u6216\u6570\u636e\u5904\u7406\u4efb\u52a1\u3002</li> <li>\u5907\u4efd\u91cd\u8981\u914d\u7f6e\u548c\u4e1a\u52a1\u6570\u636e\u3002</li> <li>\u8bb0\u5f55\u5f53\u524d\u7248\u672c\u53f7\uff0c\u4fbf\u4e8e\u66f4\u65b0\u540e\u56de\u9000\u6216\u6392\u67e5\u3002</li> <li>\u9009\u62e9\u4e1a\u52a1\u4f4e\u5cf0\u671f\u6267\u884c\uff0c\u5e76\u63d0\u524d\u901a\u77e5\u4f7f\u7528\u4eba\u5458\u3002</li> </ul> <p>\u66f4\u65b0\u5b8c\u6210\u540e\uff0c\u91cd\u65b0\u767b\u5f55\u5e76\u68c0\u67e5\u7cfb\u7edf\u603b\u89c8\u3001\u8bbe\u5907\u4e0e\u8d44\u4ea7\u3001\u8bc6\u522b\u548c API \u7ba1\u7406\u7b49\u6838\u5fc3\u9875\u9762\u3002</p> <p>\u66f4\u65b0\u540e\u5efa\u8bae\u6267\u884c\u4e00\u6b21\u6700\u5c0f\u53ef\u7528\u6027\u9a8c\u8bc1\uff1a\u4f7f\u7528\u6d4b\u8bd5\u8d26\u53f7\u767b\u5f55\u3001\u6253\u5f00\u8bbe\u5907\u4e0e\u8d44\u4ea7\u3001\u67e5\u770b\u4e00\u6761\u8bc6\u522b\u7ed3\u679c\u3001\u8c03\u7528\u4e00\u4e2a\u5df2\u6388\u6743 API\u3002\u9a8c\u8bc1\u5931\u8d25\u65f6\u8bb0\u5f55\u7248\u672c\u53f7\u548c\u65e5\u5fd7\u7f16\u53f7\uff0c\u4e0d\u8981\u91cd\u590d\u70b9\u51fb\u66f4\u65b0\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_10","title":"\u5e38\u89c1\u95ee\u9898","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_11","title":"\u770b\u4e0d\u5230\u7cfb\u7edf\u7ba1\u7406\u83dc\u5355","text":"<p>\u5f53\u524d\u8d26\u53f7\u53ef\u80fd\u4e0d\u662f\u7ba1\u7406\u5458\uff0c\u6216\u672a\u88ab\u6388\u4e88\u7cfb\u7edf\u7ba1\u7406\u76f8\u5173\u6743\u9650\u3002\u8bf7\u8054\u7cfb\u7ba1\u7406\u5458\u786e\u8ba4\u8d26\u53f7\u89d2\u8272\u548c\u6743\u9650\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_12","title":"\u4fee\u6539\u6743\u9650\u540e\u4ecd\u7136\u65e0\u6cd5\u8bbf\u95ee","text":"<p>\u9000\u51fa\u5f53\u524d\u8d26\u53f7\u5e76\u91cd\u65b0\u767b\u5f55\uff1b\u5982\u679c\u95ee\u9898\u4ecd\u5b58\u5728\uff0c\u8bf7\u5728\u65e5\u5fd7\u7ba1\u7406\u4e2d\u68c0\u67e5\u6743\u9650\u53d8\u66f4\u8bb0\u5f55\uff0c\u5e76\u786e\u8ba4\u89d2\u8272\u5df2\u7ed1\u5b9a\u5230\u6b63\u786e\u7528\u6237\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E7%B3%BB%E7%BB%9F%E7%AE%A1%E7%90%86/#_13","title":"\u603b\u89c8\u9875\u9762\u663e\u793a\u5f02\u5e38","text":"<p>\u5148\u5237\u65b0\u9875\u9762\u5e76\u786e\u8ba4\u7f51\u7edc\u8fde\u63a5\uff0c\u518d\u67e5\u770b\u65e5\u5fd7\u7ba1\u7406\u4e2d\u7684\u9519\u8bef\u8bb0\u5f55\u3002\u82e5\u5e73\u53f0\u7248\u672c\u521a\u66f4\u65b0\uff0c\u786e\u8ba4\u66f4\u65b0\u4efb\u52a1\u5df2\u5b8c\u6210\u540e\u518d\u91cd\u8bd5\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AE%BE%E5%A4%87%E4%B8%8E%E8%B5%84%E4%BA%A7/","title":"\u8bbe\u5907\u4e0e\u8d44\u4ea7","text":"<p>\u70b9\u51fb\u201c\u8bbe\u5907\u4e0e\u8d44\u4ea7\u201d\uff0c\u9875\u9762\u9876\u90e8\u663e\u793a\u5404\u7c7b\u8d44\u4ea7\u7684\u6570\u91cf\u7edf\u8ba1\u3002</p> <p></p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AE%BE%E5%A4%87%E4%B8%8E%E8%B5%84%E4%BA%A7/#_1","title":"\u67e5\u770b\u8d44\u4ea7","text":"<ol> <li>\u5728\u5de6\u4fa7\u5bfc\u822a\u9009\u62e9 \u8bbe\u5907\u4e0e\u8d44\u4ea7\u3002</li> <li>\u5148\u67e5\u770b\u9875\u9762\u9876\u90e8\u7684\u6570\u91cf\u7edf\u8ba1\uff0c\u786e\u8ba4\u8bbe\u5907\u3001\u89c6\u9891\u6e90\u6216\u5176\u4ed6\u8d44\u4ea7\u662f\u5426\u5df2\u52a0\u8f7d\u3002</li> <li>\u5728\u5217\u8868\u4e2d\u6309\u540d\u79f0\u3001\u72b6\u6001\u6216\u7c7b\u578b\u7b5b\u9009\uff0c\u6253\u5f00\u76ee\u6807\u8d44\u4ea7\u67e5\u770b\u8be6\u60c5\u3002</li> <li>\u4fee\u6539\u6216\u5220\u9664\u524d\u6838\u5bf9\u8d44\u4ea7\u662f\u5426\u88ab\u8bc6\u522b\u4efb\u52a1\u3001\u4e8b\u4ef6\u89c4\u5219\u6216\u6a21\u578b\u5f15\u7528\u3002</li> </ol>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AE%BE%E5%A4%87%E4%B8%8E%E8%B5%84%E4%BA%A7/#_2","title":"\u72b6\u6001\u5224\u65ad","text":"<ul> <li>\u5728\u7ebf/\u6b63\u5e38\uff1a\u5e73\u53f0\u6700\u8fd1\u4e00\u6b21\u68c0\u67e5\u80fd\u591f\u8bbf\u95ee\u8d44\u4ea7\u3002</li> <li>\u79bb\u7ebf/\u5f02\u5e38\uff1a\u5148\u786e\u8ba4\u8bbe\u5907\u7f51\u7edc\u3001\u7535\u6e90\u548c\u5730\u5740\uff0c\u518d\u5237\u65b0\u5e73\u53f0\u72b6\u6001\u3002</li> <li>\u672a\u914d\u7f6e\uff1a\u8865\u9f50\u8fde\u63a5\u53c2\u6570\u5e76\u4fdd\u5b58\uff0c\u968f\u540e\u91cd\u65b0\u6253\u5f00\u8be6\u60c5\u786e\u8ba4\u914d\u7f6e\u5df2\u6301\u4e45\u5316\u3002</li> </ul> <p>\u65b0\u589e\u8bbe\u5907\u540e\u5efa\u8bae\u7acb\u5373\u6267\u884c\u4e00\u6b21\u8fde\u901a\u6027\u6216\u9884\u89c8\u9a8c\u8bc1\uff0c\u5e76\u8bb0\u5f55\u8bbe\u5907\u540d\u79f0\u3001\u5730\u5740\u3001\u8d1f\u8d23\u4eba\u548c\u7528\u9014\uff0c\u4fbf\u4e8e\u540e\u7eed\u6392\u969c\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AF%86%E5%88%AB/","title":"\u8bc6\u522b","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AF%86%E5%88%AB/#_1","title":"\u529f\u80fd\u8bf4\u660e","text":"<p>\u8bc6\u522b\u7528\u4e8e\u914d\u7f6e\u8bc6\u522b\u4efb\u52a1\u3001\u9009\u62e9\u6a21\u578b\u5e76\u67e5\u770b\u5206\u6790\u7ed3\u679c\u3002\u5f00\u59cb\u8bc6\u522b\u524d\uff0c\u5e94\u5148\u51c6\u5907\u53ef\u8bbf\u95ee\u7684\u89c6\u9891\u6e90\u6216\u56fe\u7247\u6570\u636e\uff0c\u5e76\u786e\u8ba4\u8d26\u53f7\u5177\u6709\u8bc6\u522b\u4f7f\u7528\u6743\u9650\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AF%86%E5%88%AB/#_2","title":"\u521b\u5efa\u8bc6\u522b\u4efb\u52a1","text":"<ol> <li>\u8fdb\u5165 \u8bc6\u522b\uff0c\u70b9\u51fb\u65b0\u5efa\u4efb\u52a1\u3002</li> <li>\u9009\u62e9\u8bbe\u5907\u3001\u89c6\u9891\u6e90\u6216\u4e0a\u4f20\u7684\u6570\u636e\uff0c\u5e76\u8bbe\u7f6e\u4efb\u52a1\u540d\u79f0\u3002</li> <li>\u9009\u62e9\u5df2\u53d1\u5e03\u7684\u8bc6\u522b\u6a21\u578b\u6216\u8bc6\u522b\u5de5\u4f5c\u6d41\uff0c\u914d\u7f6e\u65f6\u95f4\u8303\u56f4\u548c\u89e6\u53d1\u6761\u4ef6\u3002</li> <li>\u4fdd\u5b58\u540e\u542f\u52a8\u4efb\u52a1\uff0c\u5728\u4efb\u52a1\u5217\u8868\u786e\u8ba4\u72b6\u6001\u53d8\u4e3a\u8fd0\u884c\u4e2d\u3002</li> </ol> <p>\u4efb\u52a1\u72b6\u6001\u901a\u5e38\u5305\u62ec\u7b49\u5f85\u3001\u8fd0\u884c\u4e2d\u3001\u5df2\u5b8c\u6210\u548c\u5931\u8d25\u3002\u5931\u8d25\u65f6\u5148\u67e5\u770b\u4efb\u52a1\u8be6\u60c5\u548c\u65e5\u5fd7\uff0c\u518d\u68c0\u67e5\u89c6\u9891\u6e90\u8fde\u901a\u6027\u3001\u6a21\u578b\u72b6\u6001\u53ca\u5b58\u50a8\u7a7a\u95f4\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E8%AF%86%E5%88%AB/#_3","title":"\u67e5\u770b\u7ed3\u679c","text":"<p>\u6253\u5f00\u4efb\u52a1\u8be6\u60c5\u53ef\u67e5\u770b\u8bc6\u522b\u65f6\u95f4\u3001\u76ee\u6807\u7c7b\u522b\u3001\u7f6e\u4fe1\u5ea6\u548c\u5173\u8054\u8bc1\u636e\u3002\u5bf9\u7591\u4f3c\u8bef\u62a5\u7684\u7ed3\u679c\u5e94\u4f7f\u7528\u5e73\u53f0\u63d0\u4f9b\u7684\u8bef\u62a5\u5904\u7406\u5165\u53e3\uff0c\u4e0d\u8981\u76f4\u63a5\u5220\u9664\u539f\u59cb\u8bc1\u636e\u3002</p>"},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E9%80%80%E5%87%BA/","title":"\u9000\u51fa","text":""},{"location":"%E5%8A%9F%E8%83%BD%E4%B8%8E%E4%BD%BF%E7%94%A8/%E9%80%80%E5%87%BA/#_1","title":"\u9000\u51fa\u5e73\u53f0","text":"<p>\u5b8c\u6210\u64cd\u4f5c\u540e\u70b9\u51fb\u53f3\u4e0a\u89d2\u7528\u6237\u83dc\u5355\u4e2d\u7684 \u9000\u51fa\u767b\u5f55\u3002\u9000\u51fa\u540e\u786e\u8ba4\u9875\u9762\u56de\u5230\u767b\u5f55\u9875\uff0c\u5c24\u5176\u662f\u5728\u5171\u4eab\u7535\u8111\u6216\u5904\u7406\u654f\u611f\u6570\u636e\u65f6\u3002</p> <p>\u5982\u679c\u9875\u9762\u5f02\u5e38\u65e0\u6cd5\u9000\u51fa\uff0c\u5173\u95ed\u5f53\u524d\u6d4f\u89c8\u5668\u7a97\u53e3\u5e76\u6e05\u9664\u8be5\u7ad9\u70b9\u4f1a\u8bdd\uff1b\u4e0d\u8981\u4ec5\u4f9d\u8d56\u5173\u95ed\u6807\u7b7e\u9875\u6765\u4fdd\u62a4\u8d26\u53f7\u3002</p>"},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/","title":"Q&A","text":""},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/#_1","title":"\u9875\u9762\u65e0\u6cd5\u6253\u5f00\u6216\u4e00\u76f4\u52a0\u8f7d","text":"<p>\u786e\u8ba4\u4f01\u4e1a\u7f51\u7edc\u6216 VPN \u5df2\u8fde\u63a5\uff0c\u5e76\u4f7f\u7528\u6700\u65b0\u7248\u6d4f\u89c8\u5668\u3002\u82e5\u53ea\u6709\u67d0\u4e2a\u9875\u9762\u5f02\u5e38\uff0c\u5237\u65b0\u540e\u67e5\u770b\u7cfb\u7edf\u7ba1\u7406\u4e2d\u7684\u65e5\u5fd7\uff1b\u82e5\u6240\u6709\u9875\u9762\u90fd\u5f02\u5e38\uff0c\u8054\u7cfb\u5e73\u53f0\u7ba1\u7406\u5458\u786e\u8ba4\u670d\u52a1\u72b6\u6001\u3002</p>"},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/#_2","title":"\u6ca1\u6709\u770b\u5230\u67d0\u4e2a\u83dc\u5355","text":"<p>\u83dc\u5355\u7531\u8d26\u53f7\u89d2\u8272\u548c\u6743\u9650\u51b3\u5b9a\u3002\u9000\u51fa\u5e76\u91cd\u65b0\u767b\u5f55\u540e\u4ecd\u4e0d\u53ef\u89c1\uff0c\u63d0\u4f9b\u8d26\u53f7\u3001\u8bbf\u95ee\u65f6\u95f4\u548c\u671f\u671b\u529f\u80fd\u7ed9\u7ba1\u7406\u5458\u6838\u5bf9\uff0c\u4e0d\u8981\u4f7f\u7528\u4ed6\u4eba\u8d26\u53f7\u4ee3\u66ff\u64cd\u4f5c\u3002</p>"},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/#_3","title":"\u4efb\u52a1\u5931\u8d25","text":"<p>\u6253\u5f00\u4efb\u52a1\u8be6\u60c5\u8bb0\u5f55\u5931\u8d25\u65f6\u95f4\u548c\u9519\u8bef\u4fe1\u606f\uff0c\u68c0\u67e5\u8bbe\u5907\u8fde\u63a5\u3001\u6a21\u578b\u72b6\u6001\u3001\u6570\u636e\u683c\u5f0f\u548c\u5b58\u50a8\u7a7a\u95f4\u3002\u4fee\u6b63\u539f\u56e0\u540e\u518d\u91cd\u8bd5\uff0c\u5e76\u907f\u514d\u5e76\u884c\u63d0\u4ea4\u5927\u91cf\u76f8\u540c\u4efb\u52a1\u3002</p>"},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/#_4","title":"\u7ed3\u679c\u4e0e\u73b0\u573a\u4e0d\u4e00\u81f4","text":"<p>\u5148\u6838\u5bf9\u4e8b\u4ef6\u65f6\u95f4\u3001\u8bbe\u5907\u548c\u539f\u59cb\u8bc1\u636e\uff0c\u518d\u68c0\u67e5\u6a21\u578b\u7248\u672c\u3001\u89c4\u5219\u914d\u7f6e\u548c\u89c6\u9891\u6e90\u8d28\u91cf\u3002\u5fc5\u8981\u65f6\u5c06\u4e8b\u4ef6\u6807\u8bb0\u4e3a\u8bef\u62a5\u6216\u8fdb\u5165\u6574\u6539\u6d41\u7a0b\uff0c\u4e0d\u8981\u76f4\u63a5\u5220\u9664\u8bb0\u5f55\u3002</p>"},{"location":"%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/%E5%B8%B8%E8%A7%81%E9%97%AE%E9%A2%98/#api","title":"API \u8c03\u7528\u8fd4\u56de\u672a\u6388\u6743","text":"<p>\u786e\u8ba4\u4ee4\u724c\u672a\u8fc7\u671f\u3001\u63a5\u53e3\u7248\u672c\u6b63\u786e\u4e14\u8d26\u53f7\u5177\u6709\u5bf9\u5e94\u6743\u9650\u3002\u4ee4\u724c\u7591\u4f3c\u6cc4\u9732\u65f6\u7acb\u5373\u64a4\u9500\u5e76\u91cd\u65b0\u521b\u5efa\uff0c\u4e0d\u8981\u628a\u4ee4\u724c\u53d1\u9001\u5230\u804a\u5929\u6216\u5de5\u5355\u4e2d\u3002</p>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%8E%AF%E5%A2%83/","title":"\u914d\u7f6e\u73af\u5883","text":""},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%8E%AF%E5%A2%83/#_1","title":"\u4f7f\u7528\u524d\u51c6\u5907","text":"<ul> <li>\u4f7f\u7528\u4f01\u4e1a\u7f51\u7edc\u6216\u5df2\u8fde\u63a5 VPN \u7684\u7535\u8111\u8bbf\u95ee\u5e73\u53f0\u3002</li> <li>\u63a8\u8350\u4f7f\u7528\u6700\u65b0\u7248 Chrome\u3001Edge \u6216\u5176\u4ed6\u652f\u6301\u73b0\u4ee3 JavaScript \u7684\u6d4f\u89c8\u5668\u3002</li> <li>\u786e\u4fdd\u6d4f\u89c8\u5668\u5141\u8bb8 JavaScript\u3001Cookie \u548c\u540c\u6e90\u8bf7\u6c42\uff1b\u5e73\u53f0\u9875\u9762\u7531\u524d\u7aef\u52a8\u6001\u52a0\u8f7d\u3002</li> <li>\u4f7f\u7528\u5e73\u53f0\u524d\u786e\u8ba4\u8d26\u53f7\u5df2\u5206\u914d\u5bf9\u5e94\u89d2\u8272\uff0c\u5e76\u51c6\u5907\u597d\u9700\u8981\u63a5\u5165\u7684\u8bbe\u5907\u3001\u89c6\u9891\u6e90\u6216\u6570\u636e\u6587\u4ef6\u3002</li> </ul>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%8E%AF%E5%A2%83/#_2","title":"\u7f51\u7edc\u4e0e\u6d4f\u89c8\u5668\u68c0\u67e5","text":"<ol> <li>\u6253\u5f00\u5e73\u53f0\u9996\u9875\uff0c\u786e\u8ba4\u9875\u9762\u80fd\u6b63\u5e38\u663e\u793a\u767b\u5f55\u6846\u3002</li> <li>\u767b\u5f55\u540e\u5237\u65b0\u4e00\u6b21\u9875\u9762\uff0c\u786e\u8ba4\u5de6\u4fa7\u5bfc\u822a\u548c\u7cfb\u7edf\u72b6\u6001\u80fd\u591f\u52a0\u8f7d\u3002</li> <li>\u82e5\u9875\u9762\u7a7a\u767d\u6216\u4e00\u76f4\u52a0\u8f7d\uff0c\u5148\u68c0\u67e5\u6d4f\u89c8\u5668\u5f00\u53d1\u8005\u5de5\u5177\u4e2d\u7684\u7f51\u7edc\u9519\u8bef\uff0c\u518d\u8054\u7cfb\u5e73\u53f0\u7ba1\u7406\u5458\u3002</li> </ol> <p>\u5e73\u53f0\u5730\u5740\u3001\u8d26\u53f7\u6743\u9650\u548c\u670d\u52a1\u72b6\u6001\u7531\u7ba1\u7406\u5458\u7ef4\u62a4\uff0c\u624b\u518c\u4e2d\u7684\u793a\u4f8b\u5730\u5740\u4e0d\u5e94\u76f4\u63a5\u7528\u4e8e\u751f\u4ea7\u73af\u5883\u914d\u7f6e\u3002</p>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%99%BB%E5%BD%95/","title":"\u8d26\u53f7\u767b\u5f55","text":""},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%99%BB%E5%BD%95/#_1","title":"\u767b\u5f55\u5e73\u53f0","text":"<ol> <li>\u5728\u6d4f\u89c8\u5668\u6253\u5f00\u5e73\u53f0\u5730\u5740\uff0c\u4f8b\u5982 <code>http://10.136.10.43:8280</code>\u3002</li> <li>\u8f93\u5165\u7ba1\u7406\u5458\u6216\u4e1a\u52a1\u4eba\u5458\u63d0\u4f9b\u7684\u8d26\u53f7\u548c\u5bc6\u7801\uff0c\u70b9\u51fb \u767b\u5f55\u3002</li> <li>\u9996\u6b21\u767b\u5f55\u540e\u786e\u8ba4\u5de6\u4fa7\u83dc\u5355\u4e0e\u8d26\u53f7\u89d2\u8272\u5339\u914d\uff1b\u666e\u901a\u7528\u6237\u4e0d\u5e94\u770b\u5230\u7cfb\u7edf\u7ba1\u7406\u7b49\u7ba1\u7406\u5165\u53e3\u3002</li> </ol>"},{"location":"%E5%BF%AB%E9%80%9F%E5%BC%80%E5%A7%8B/%E7%99%BB%E5%BD%95/#_2","title":"\u767b\u5f55\u5f02\u5e38","text":"<ul> <li>\u9875\u9762\u65e0\u6cd5\u6253\u5f00\uff1a\u786e\u8ba4\u5df2\u8fde\u63a5\u4f01\u4e1a\u7f51\u7edc\u6216 VPN\uff0c\u5e76\u68c0\u67e5\u5730\u5740\u548c\u7aef\u53e3\u662f\u5426\u6b63\u786e\u3002</li> <li>\u63d0\u793a\u8d26\u53f7\u6216\u5bc6\u7801\u9519\u8bef\uff1a\u786e\u8ba4\u8f93\u5165\u6cd5\u3001\u5927\u5c0f\u5199\u548c\u8d26\u53f7\u72b6\u6001\uff1b\u8fde\u7eed\u5931\u8d25\u65f6\u8054\u7cfb\u7ba1\u7406\u5458\u3002</li> <li>\u767b\u5f55\u540e\u83dc\u5355\u4e0d\u5b8c\u6574\uff1a\u9000\u51fa\u540e\u91cd\u65b0\u767b\u5f55\uff1b\u4ecd\u672a\u6062\u590d\u65f6\u8054\u7cfb\u7ba1\u7406\u5458\u68c0\u67e5\u89d2\u8272\u6743\u9650\u3002</li> </ul> <p>\u767b\u5f55\u6210\u529f\u540e\u4e0d\u8981\u5728\u516c\u5171\u7535\u8111\u4fdd\u5b58\u5bc6\u7801\u3002\u79bb\u5f00\u7535\u8111\u524d\u5e94\u9000\u51fa\u8d26\u53f7\u3002</p>"}]}